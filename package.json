{
  "name": "personal-knowledge-mcp-server",
  "version": "0.1.0",
  "description": "Expose your personal notes (Markdown/Obsidian/Notion export) as MCP resources and tools for search and summarization.",
  "type": "module",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "security-check": "node scripts/security-check.mjs"
  },
  "bin": {
    "personal-knowledge-mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "obsidian",
    "notion",
    "markdown",
    "knowledge-base",
    "notes"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
